# ==============================================================================
# Sparnarok: The Architect's Codex - Variables de Entorno de Desarrollo
# ==============================================================================
# Copia este archivo a `.env` o configura estas variables en tu entorno local.

# ------------------------------------------------------------------------------
# Frontend (Vite / React 19)
# ------------------------------------------------------------------------------
# Client ID de Google OAuth2 generado en Google Cloud Console (APIs & Services > Credentials > OAuth 2.0 Client IDs)
# Tipo de aplicación: Single Page Application (SPA)
# Orígenes de JavaScript autorizados: http://localhost:5173
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ------------------------------------------------------------------------------
# Backend (.NET 10 Web API)
# ------------------------------------------------------------------------------
# Clave simétrica para firma y verificación de JWT (mínimo 256 bits / 32 caracteres)
Authentication__Jwt__Key=Sparnarok_Super_Secret_Key_For_Jwt_Token_Signing_2026_Minimum_256_Bits!
Authentication__Jwt__Issuer=SparnarokApi
Authentication__Jwt__Audience=SparnarokWeb
Authentication__Jwt__ExpiryDays=7

# Google OAuth2 Client ID y Client Secret para validación en el backend
# Nota: Puedes configurar estos valores en appsettings.private.json para que no se versionen en Git.
Authentication__Google__ClientId=your-google-client-id.apps.googleusercontent.com
Authentication__Google__ClientSecret=your-google-client-secret
Authentication__Google__ProjectId=your-google-project-id



# Conexión relacional PostgreSQL
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=sparnarok_dev_db;Username=sparnarok;Password=sparnarok_secret
